{
  "name": "fub-screenless-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:shared && npm run build:openclaw-bridge && npm run build:skyslope && npm run build:slybroadcast-voicemail && npm run build:newton-supplier && npm run build:newton-link && npm run build:velocity-mortgage && npm run build:crea-ddf-mcp",
    "build:shared": "npm --workspace @zillob/shared run build",
    "clean": "rm -rf packages/*/dist coverage",
    "dev:mcp": "npm --workspace @fub/mcp-server run dev",
    "dev:kvcore-mcp": "npm --workspace @fub/kvcore-mcp-server run dev",
    "dev:webhooks": "npm --workspace @fub/webhooks run dev",
    "build:skyslope": "npm --workspace @fub/skyslope-deal-manager run build",
    "build:slybroadcast-voicemail": "npm --workspace @fub/slybroadcast-voicemail run build",
    "build:openclaw-bridge": "npm --workspace @fub/realtor-openclaw-bridge run build",
    "build:newton-supplier": "npm --workspace @fub/newton-supplier-api run build",
    "build:newton-link": "npm --workspace @fub/newton-lender-link run build",
    "build:velocity-mortgage": "npm --workspace @fub/velocity-mortgage run build",
    "dev:skyslope-cli": "npm --workspace @fub/skyslope-deal-manager run dev:cli --",
    "dev:skyslope-mcp": "npm --workspace @fub/skyslope-deal-manager run dev:mcp",
    "dev:slybroadcast-cli": "npm --workspace @fub/slybroadcast-voicemail run dev:cli --",
    "dev:slybroadcast-mcp": "npm --workspace @fub/slybroadcast-voicemail run dev:mcp",
    "dev:openclaw-bridge-cli": "npm --workspace @fub/realtor-openclaw-bridge run dev:cli --",
    "dev:openclaw-bridge-mcp": "npm --workspace @fub/realtor-openclaw-bridge run dev:mcp",
    "dev:newton-supplier-cli": "npm --workspace @fub/newton-supplier-api run dev:cli --",
    "dev:newton-supplier-mcp": "npm --workspace @fub/newton-supplier-api run dev:mcp",
    "dev:newton-link-cli": "npm --workspace @fub/newton-lender-link run dev:cli --",
    "dev:newton-link-mcp": "npm --workspace @fub/newton-lender-link run dev:mcp",
    "dev:velocity-mortgage-cli": "npm --workspace @fub/velocity-mortgage run dev:cli --",
    "dev:velocity-mortgage-mcp": "npm --workspace @fub/velocity-mortgage run dev:mcp",
    "test": "npm --workspace @fub/core run test",
    "lint": "npm run build",
    "demo": "tsx scripts/demo.ts",
    "build:crea-ddf-mcp": "npm --workspace @fub/crea-ddf-mcp run build",
    "dev:crea-ddf-cli": "npm --workspace @fub/crea-ddf-mcp run dev:cli --",
    "dev:crea-ddf-mcp": "npm --workspace @fub/crea-ddf-mcp run dev:mcp"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
